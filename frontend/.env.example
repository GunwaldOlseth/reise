# Local Go backend. `npm run dev` ignores Cloud Run URLs and uses Vite `/api` proxy.
# VITE_API_URL=/api
# Override only if Go is not on 8082, e.g. http://localhost:8083/api

# Firebase web (Google Sign-In — config is public by design)

# Firebase web (Google Sign-In — config is public by design)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=homey-376215.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=homey-376215
VITE_FIREBASE_APP_ID=

# Enable Google provider once:
# https://console.firebase.google.com/project/homey-376215/authentication/providers
# Or run: powershell -File scripts/setup-google-auth.ps1
