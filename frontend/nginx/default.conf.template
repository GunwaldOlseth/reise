server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    charset utf-8;
    charset_types
        text/html
        text/css
        text/plain
        text/xml
        application/javascript
        application/json
        application/xml;

    location / {
        default_type text/html;
        try_files $uri $uri/ /index.html;
    }

    location ~* \.js$ {
        default_type application/javascript;
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location ~* \.(css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
